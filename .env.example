# ======================================================================
# PolyMatrix - Google Gemini API Environment Configuration
# ======================================================================
# 1. Google AI Studio(https://aistudio.google.com/)에서 API Key를 발급받습니다.
# 2. 이 파일을 복사하여 같은 디렉토리에 '.env' 또는 '.env.local' 파일을 생성합니다.
# 3. 아래 VITE_GEMINI_API_KEY에 발급받은 API 키를 입력합니다.
# 4. Vite 개발 서버를 재실행(npm run dev)하면 자동으로 적용됩니다.
#
# 주의: '.env' 파일은 .gitignore에 등록되어 있으므로 Git에 커밋되지 않아 안전합니다.
# ======================================================================

# Google Gemini API Key
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 권장 모델: gemini-2.5-flash 또는 gemini-3.8-flash
VITE_GEMINI_MODEL=gemini-2.5-flash

# GCP Project ID (선택: Vertex AI 연동 시 사용)
VITE_GCP_PROJECT_ID=your_gcp_project_id

# 외부 백엔드 API 서버 주소 (선택: 별도 PostgreSQL+pgvector API 서버 연결 시 설정, 미설정 시 정적 하이브리드 인덱스 자동 폴백)
# VITE_API_BASE_URL=https://your-backend-server.example.com

# ======================================================================
# PostgreSQL 16 + pgvector (Docker: pgvector/pgvector:pg16) & RAG Daemon
# ======================================================================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=polymatrix
POSTGRES_PASSWORD=polymatrix2026
POSTGRES_DB=polymatrix_rag
DATABASE_URL=postgresql://polymatrix:polymatrix2026@127.0.0.1:5432/polymatrix_rag

# RAG 데이터 재활용 안정화 주기 (기본: 15초마다 2건 생성 및 탈락/이관 전수 보관)
DAEMON_INTERVAL_MS=15000
DAEMON_BATCH_SIZE=2
